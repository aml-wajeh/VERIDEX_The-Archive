# =============================================================================
# Environment variable template for the Full RAG Project.
#
# Usage:
#   1) Copy this file to .env :  cp .env.example .env   (or: copy .env.example .env)
#   2) Fill in your real values inside .env
#   3) NEVER commit the real .env file (it is ignored by .gitignore)
#   4) For Streamlit Cloud deployment, mirror these values into Streamlit Secrets
#
# All variables below are optional at build time. Secrets (GROQ_API_KEY) become
# mandatory only when the generation phase runs; the app validates that then.
# Filesystem paths are auto-detected and auto-created; they are NOT configured
# here on purpose.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider (Groq)
# -----------------------------------------------------------------------------
GROQ_API_KEY="replace-with-your-groq-api-key"
MODEL_NAME="llama-3.1-8b-instant"

# -----------------------------------------------------------------------------
# Optional Hugging Face token (only needed for gated / private models)
# -----------------------------------------------------------------------------
HF_TOKEN=""

# -----------------------------------------------------------------------------
# Embedding model (sentence-transformers identifier)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# -----------------------------------------------------------------------------
# Generation hyper-parameters
# -----------------------------------------------------------------------------
TEMPERATURE="0.0"
MAX_TOKENS="512"

# -----------------------------------------------------------------------------
# Retrieval & chunking hyper-parameters
# Constraint: 0 <= CHUNK_OVERLAP < CHUNK_SIZE
# -----------------------------------------------------------------------------
TOP_K="5"
CHUNK_SIZE="500"
CHUNK_OVERLAP="50"
COLLECTION_NAME="squad_v2_chunks"

# -----------------------------------------------------------------------------
# Application behaviour
# LOG_LEVEL must be one of: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG must be boolean-like: true/false/1/0/yes/no
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"
DEBUG="false"

# -----------------------------------------------------------------------------
# Legacy / optional (NOT read by the current config layer; kept for reference
# to the original course deployment instructions). Safe to leave empty.
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="openai/gpt-4o-mini"
